rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/backups/latest {
   allow read: if request.auth != null && request.auth.uid == userId;
   allow create, update: if request.auth != null && request.auth.uid == userId
    && request.resource.data.keys().hasOnly(['schemaVersion','payload','savedAt'])
    && request.resource.data.schemaVersion == 1
    && request.resource.data.payload is string
    && request.resource.data.payload.size() < 900000
    && request.resource.data.savedAt is timestamp;
  }
 }
}
